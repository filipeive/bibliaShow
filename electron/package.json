{
  "name": "biblia-show-desktop",
  "version": "2.0.0",
  "description": "Bíblia Show 2.0 - Edição de Igreja e Telão",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg"
  },
  "homepage": "http://146.235.224.99/bibliashow",
  "author": {
    "name": "Fdsmultiservices",
    "email": "fdsmultiservices@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.bibliashow.desktop",
    "productName": "Bíblia Show 2.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "category": "Game",
      "maintainer": "Fdsmultiservices <fdsmultiservices@gmail.com>"
    },
    "win": {
      "target": "nsis"
    }
  }
}
